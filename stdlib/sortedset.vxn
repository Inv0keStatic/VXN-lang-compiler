import std.order as keys;
import std.sortedmap as maps;

pub struct Set[T] { maps::Map[T,bool] map; }
pub choice SetResult[T] { Ok(Set[T]), Err(AllocError) }
pub choice Insert[T] { Inserted, Present(T), Allocation(AllocError,T) }

pub safe io nopanic SetResult[T] create[T:Move]() {
    return match maps::create[T,bool]() {
        maps::MapResult[T,bool]::Ok(const map)->SetResult[T]::Ok(Set[T]{map=map}),
        maps::MapResult[T,bool]::Err(const error)->SetResult[T]::Err(error)
    };
}
pub safe pure hot wrap uint32 size[T:Move](const ref Set[T] set)=maps::size(ref set.map);
pub safe pure hot wrap uint32 capacity[T:Move](const ref Set[T] set)=maps::capacity(ref set.map);
pub safe io AllocResult reserve[T:Move](const uniq mut Set[T] set,const wrap uint32 additional)=maps::reserve(uniq mut set.map,additional);
pub safe io void clear[T:Move](const uniq mut Set[T] set)=maps::clear(uniq mut set.map);
pub safe pure hot bool contains[T:keys::Order](const ref Set[T] set,const ref T value)=maps::contains(ref set.map,value);

pub safe io Insert[T] insert[T:keys::Order](const uniq mut Set[T] set,const T value) {
    return match maps::insert(uniq mut set.map,value,false) {
        maps::Insert[T,bool]::Inserted->Insert[T]::Inserted,
        maps::Insert[T,bool]::Occupied(const returned)->Insert[T]::Present(returned.key),
        maps::Insert[T,bool]::Allocation(const error,const returned)->Insert[T]::Allocation(error,returned.key)
    };
}
pub safe io VecPop[T] remove[T:keys::Order](const uniq mut Set[T] set,const ref T value) {
    return match maps::remove(uniq mut set.map,value) {
        VecPop[maps::Entry[T,bool]]::Some(const returned)->VecPop[T]::Some(returned.key),
        VecPop[maps::Entry[T,bool]]::Empty->VecPop[T]::Empty
    };
}

pub safe pure hot Slice[maps::Entry[T,bool]] view[T:Move](const ref Set[T] set) from(set)=maps::view(ref set.map);
pub safe pure hot wrap uint32 lower_bound[T:keys::Order](const ref Set[T] set,const ref T key)=maps::lower_bound(ref set.map,key);
pub safe pure hot wrap uint32 upper_bound[T:keys::Order](const ref Set[T] set,const ref T key)=maps::upper_bound(ref set.map,key);
