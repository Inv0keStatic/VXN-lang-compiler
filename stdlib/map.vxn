import std.equal as keys;

// Insertion-ordered, contiguous map. Lookup is linear, with no hash-law trust.
pub struct Entry[K, V] { K key; V value; }
pub struct Map[K, V] { Vec[Entry[K, V]] entries; }
pub choice MapResult[K, V] { Ok(Map[K, V]), Err(AllocError) }
pub choice Lookup { Found(wrap uint32), Missing }
pub choice Insert[K, V] { Inserted, Occupied(Entry[K, V]), Allocation(AllocError, Entry[K, V]) }

pub safe io nopanic MapResult[K, V] create[K: Move, V: Move]() {
    return match vec_new[Entry[K, V]]() {
        VecResult[Entry[K, V]]::Ok(const entries) -> MapResult[K, V]::Ok(Map[K, V] { entries = entries }),
        VecResult[Entry[K, V]]::Err(const error) -> MapResult[K, V]::Err(error)
    };
}

pub safe pure hot wrap uint32 size[K: Move, V: Move](const ref Map[K, V] map) = vec_len(ref map.entries);
pub safe pure hot wrap uint32 capacity[K: Move, V: Move](const ref Map[K, V] map) = vec_capacity(ref map.entries);
pub safe pure hot Slice[Entry[K, V]] view[K: Move, V: Move](const ref Map[K, V] map) from(map) = vec_slice(ref map.entries);
pub safe io nopanic AllocResult reserve[K: Move, V: Move](const uniq mut Map[K, V] map, const wrap uint32 additional) =
    vec_reserve(uniq mut map.entries, additional);
pub safe io nopanic void clear[K: Move, V: Move](const uniq mut Map[K, V] map) = vec_clear(uniq mut map.entries);

pub safe pure hot Lookup find[K: keys::Equal, V: Move](const ref Map[K, V] map, const ref K key) {
    const Slice[Entry[K, V]] entries = view(map);
    for (mut wrap uint32 i = 0; i < len(entries); i++) {
        if (keys::Equal[K]::equal(ref entries[i].key, key)) { return Lookup::Found(i); }
    }
    return Lookup::Missing;
}

// A borrowed predicate permits heterogeneous lookup, e.g. str against String.
pub safe pure Lookup find_where[K: Move, V: Move](
    const ref Map[K, V] map, const FnRef[safe pure fn(const ref K)->bool] predicate
) {
    const Slice[Entry[K, V]] entries = view(map);
    for (mut wrap uint32 i = 0; i < len(entries); i++) {
        if (predicate(ref entries[i].key)) { return Lookup::Found(i); }
    }
    return Lookup::Missing;
}

pub safe pure hot bool contains[K: keys::Equal, V: Move](const ref Map[K, V] map, const ref K key) =
    match find(map, key) { Lookup::Found(_) -> true, Lookup::Missing -> false };

pub safe pure hot RefOption[V] get[K: keys::Equal, V: Move](
    const ref Map[K, V] map, const ref K key
) from(map) {
    const Slice[Entry[K, V]] entries = view(map);
    for (mut wrap uint32 i = 0; i < len(entries); i++) {
        if (keys::Equal[K]::equal(ref entries[i].key, key)) { return RefOption[V]::Some(ref entries[i].value); }
    }
    return RefOption[V]::None;
}

pub safe pure RefOption[V] get_where[K: Move, V: Move](
    const ref Map[K, V] map, const FnRef[safe pure fn(const ref K)->bool] predicate
) from(map) {
    const Slice[Entry[K, V]] entries = view(map);
    for (mut wrap uint32 i = 0; i < len(entries); i++) {
        if (predicate(ref entries[i].key)) { return RefOption[V]::Some(ref entries[i].value); }
    }
    return RefOption[V]::None;
}

pub safe io ref V value_at[K: Move, V: Move](const ref Map[K, V] map, const wrap uint32 index) from(map) {
    const Slice[Entry[K, V]] entries = view(map);
    return ref entries[index].value;
}

pub safe pure hot ref V get_or[K: keys::Equal, V: Move](
    const ref Map[K, V] map, const ref K key, const ref V fallback
) from(map, fallback) {
    const Slice[Entry[K, V]] entries = view(map);
    for (mut wrap uint32 i = 0; i < len(entries); i++) {
        if (keys::Equal[K]::equal(ref entries[i].key, key)) { return ref entries[i].value; }
    }
    return fallback;
}

// Duplicate keys and allocation failures both return the untouched input pair.
pub safe io Insert[K, V] insert[K: keys::Equal, V: Move](const uniq mut Map[K, V] map, const K key, const V value) {
    if (contains(ref map.*, ref key)) { return Insert[K, V]::Occupied(Entry[K, V] { key = key, value = value }); }
    const Entry[K, V] entry = Entry[K, V] { key = key, value = value };
    const wrap uint32 index = size(ref map.*);
    return match vec_insert(uniq mut map.entries, index, entry) {
        VecInsert[Entry[K, V]]::Ok -> Insert[K, V]::Inserted,
        VecInsert[Entry[K, V]]::Allocation(const error, const returned) -> Insert[K, V]::Allocation(error, returned),
        VecInsert[Entry[K, V]]::OutOfBounds(_) -> panic()
    };
}

pub safe io VecPop[Entry[K, V]] remove[K: keys::Equal, V: Move](const uniq mut Map[K, V] map, const ref K key) {
    return match find(ref map.*, key) {
        Lookup::Found(const index) -> vec_remove(uniq mut map.entries, index),
        Lookup::Missing -> VecPop[Entry[K, V]]::Empty
    };
}
