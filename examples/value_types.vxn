struct Reading {
    wrap uint32 value;
    bool valid;
}

choice Result {
    Value(Reading),
    Missing
}

safe pure Result lookup(const bool found) {
    if (found) {
        return Result::Value(Reading { value = 42, valid = true });
    }
    return Result::Missing;
}

safe io void main() {
    mut Reading[3] readings = {
        Reading { value = 10, valid = true },
        Reading { value = 20, valid = false },
        Reading { value = 30, valid = true }
    };

    for (mut wrap uint32 i = 0; i < len(readings); i++) {
        if (!readings[i].valid) {
            continue;
        }
        readings[i].value += 1;
        output(readings[i].value);
    }

    match lookup(true) {
        Result::Value(const reading) -> output(reading.value),
        Result::Missing -> output(0)
    }
}
