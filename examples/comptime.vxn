// Constants and these functions are evaluated before LLVM emission, even at -O0.
comptime wrap uint32 table_size = 8;

comptime safe wrap uint32[table_size] make_squares() {
    mut wrap uint32[table_size] values = {0, 0, 0, 0, 0, 0, 0, 0};
    for (mut wrap uint32 i = 0; i < table_size; i++) {
        values[i] = i * i;
    }
    return values;
}

comptime safe wrap uint32 factorial(const wrap uint32 n) {
    if (n == 0) { return 1; }
    return n * factorial(n - 1);
}

comptime wrap uint32[table_size] squares = make_squares();

safe io void main() {
    comptime wrap uint32 answer = factorial(6);
    output(answer);
    output(squares[3]);
    output(squares[7]);
    output(len(squares));
}
