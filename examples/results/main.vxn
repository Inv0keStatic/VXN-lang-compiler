import std.result::{Result};

safe pure Result[uint32, uint8] read_value(const bool succeeds) {
    if (succeeds) { return Result[uint32, uint8]::Ok(42); }
    return Result[uint32, uint8]::Err(7);
}

safe pure Result[uint64, uint8] widen(const bool succeeds) {
    const uint32 value = read_value(succeeds)?;
    return Result[uint64, uint8]::Ok(cast[uint64](value));
}

safe io nopanic void main() {
    match widen(true) {
        Result[uint64, uint8]::Ok(const value) -> output(value),
        Result[uint64, uint8]::Err(const error) -> output(error)
    }
    match widen(false) {
        Result[uint64, uint8]::Ok(const value) -> output(value),
        Result[uint64, uint8]::Err(const error) -> output(error)
    }
}
