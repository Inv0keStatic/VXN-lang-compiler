import std.sortedmap as maps;

safe io void main() {
    match maps::create[String,Box[uint32]]() {
        maps::MapResult[String,Box[uint32]]::Ok(mut map)->{
            match string_from_str("answer") {
                StringAlloc::Ok(const key)->{
                    match box_new[uint32](42) {
                        BoxResult[uint32]::Ok(const value)->{
                            match maps::insert(uniq mut map,key,value){maps::Insert[String,Box[uint32]]::Inserted->{},_->panic()}
                        },_->panic()
                    }
                },_->panic()
            }
            match string_from_str("answer") {
                StringAlloc::Ok(const key)->{
                    match box_new[uint32](7) {
                        BoxResult[uint32]::Ok(const value)->{
                            match maps::insert(uniq mut map,key,value) {
                                maps::Insert[String,Box[uint32]]::Occupied(const returned)->{
                                    output(box_into_inner(returned.value));
                                    output(str_equal(string_view(ref returned.key),"answer"));
                                },_->panic()
                            }
                        },_->panic()
                    }
                },_->panic()
            }
            const String query=match string_from_str("answer"){StringAlloc::Ok(const text)->text,_->panic()};
            match maps::get(ref map,ref query) {
                RefOption[Box[uint32]]::Some(const value)->output(box_ref(value).*),_->panic()
            }
            maps::clear(uniq mut map);
            output(maps::size(ref map));
        },_->panic()
    }
}
